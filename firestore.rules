rules_version = '2';

// Firestore rules for the Love Note project.
//
// Paste this whole file into Firebase Console → Firestore Database → Rules.
// Rules are OR-based: the specific messenger_stats block below grants write
// access, and the catch-all's `allow write: if false` does not override it.
service cloud.firestore {
  match /databases/{database}/documents {

    // Conversation stats pushed from My Messenger.
    match /messenger_stats/{docId} {
      // The Love Note website reads these publicly, so only aggregate numbers
      // are ever written here — never message content.
      allow read: if true;

      // Only the owner may write, after signing in with Google.
      allow write: if request.auth != null
                   && request.auth.uid == '7WmyHb6C2QZrHOkV0Lrt95Lv3083';
    }

    // Everything else (config, milestones): public read, no client writes.
    // Pushes from a personal machine use the Admin SDK, which bypasses rules.
    match /{document=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
